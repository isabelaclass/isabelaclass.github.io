---
import { useContent } from '../i18n/content';

const t = useContent(Astro.currentLocale);
const { formacao, cursos, idiomas, labels } = t.formacao;
---

<section id="formacao" class="container section">
	<h2 class="section-title">{t.formacao.title}</h2>
	<div class="cols">
		<div class="col col--wide">
			<div class="label">{labels.formacao}</div>
			{
				formacao.map(({ curso, local, detalhe }) => (
					<div class="row row--lg">
						<div class="display big">{curso}</div>
						<div class="strong">{local}</div>
						{detalhe && <div class="muted small">{detalhe}</div>}
					</div>
				))
			}
		</div>
		<div class="col">
			<div class="label">{labels.cursos}</div>
			{
				cursos.map(({ nome, origem }) => (
					<div class="row">
						<div class="strong tight">{nome}</div>
						<div class="muted small">{origem}</div>
					</div>
				))
			}
		</div>
		<div class="col">
			<div class="label">{labels.idiomas}</div>
			{
				idiomas.map(({ idioma, nivel }) => (
					<div class="row row--split">
						<div class="display lang">{idioma}</div>
						<div class="muted small">{nivel}</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.cols {
		display: flex;
		flex-wrap: wrap;
		gap: 40px 48px;
		margin-top: 32px;
	}
	.col {
		flex: 1 1 240px;
		min-width: 0;
	}
	.col--wide {
		flex: 2 1 360px;
	}
	.label {
		font-size: 14px;
		font-weight: 600;
		color: var(--magenta);
		margin-bottom: 14px;
	}
	.row {
		padding: 14px 0;
	}
	.row--lg {
		padding: 22px 0;
	}
	.label + .row {
		padding-top: 0;
	}
	.row + .row {
		border-top: 2px solid var(--ink);
	}
	.row:last-child {
		padding-bottom: 0;
	}
	.row--split {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
	}
	.big {
		font-size: 30px;
		line-height: 1.1;
		letter-spacing: -0.01em;
	}
	.big + .strong {
		margin-top: 8px;
	}
	.lang {
		font-size: 26px;
		line-height: 1.1;
		letter-spacing: 0;
	}
	.strong {
		font-weight: 600;
	}
	.tight {
		line-height: 1.3;
	}
	.small {
		font-size: 16px;
	}
</style>
