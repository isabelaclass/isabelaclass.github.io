---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getLang, useContent } from '../i18n/content';
import { useEsseDeal, SLUG, REPO, COLAB } from '../i18n/esse-deal';
import dados from '../data/esse-deal.json';

const lang = getLang(Astro.currentLocale);
const locale = lang === 'pt' ? 'pt-BR' : 'en';
const t = useEsseDeal(Astro.currentLocale);
const site = useContent(Astro.currentLocale);
const home = getRelativeLocaleUrl(lang);

const num = new Intl.NumberFormat(locale);
const pctFmt = new Intl.NumberFormat(locale, { style: 'percent' });
const mi = (v: number) =>
	lang === 'pt' ? `${(v / 1e6).toFixed(2).replace('.', ',')} mi` : `${(v / 1e6).toFixed(2)}M`;

// ---------- histograma: dias até fechar ----------
const H = { x0: 48, x1: 628, y0: 24, y1: 188, dmax: 140, nmax: 1400 };
const hx = (d: number) => H.x0 + (d / H.dmax) * (H.x1 - H.x0);
const hy = (n: number) => H.y1 - (n / H.nmax) * (H.y1 - H.y0);
const barras = dados.hist.map((b) => ({
	x: hx(b.de - 1) + 1,
	w: hx(b.ate) - hx(b.de - 1) - 2,
	y: hy(b.n),
	h: H.y1 - hy(b.n),
	rapido: b.ate <= 20,
}));
const ticksY = [0, 500, 1000];
const ticksX = [0, 20, 45, 90, 138];

// ---------- três destinos ----------
const d = dados.destinos;
const fatias = [
	{ k: 'ganhos', v: d.ganhos, cls: 'f-ganho', label: t.destinos.barra.ganhos },
	{ k: 'perdidos', v: d.perdidos, cls: 'f-perda', label: t.destinos.barra.perdidos },
	{ k: 'nunca', v: d.abertos, cls: 'f-nunca', label: t.destinos.barra.nunca },
];

// ---------- curva de fechamento ----------
const C = { x0: 48, x1: 628, y0: 16, y1: 196, dmax: 150 };
const cx = (dd: number) => C.x0 + (dd / C.dmax) * (C.x1 - C.x0);
const cy = (p: number) => C.y1 - (p / 100) * (C.y1 - C.y0);
const linha = (vals: number[]) =>
	vals.map((v, i) => `${i ? 'L' : 'M'}${cx(dados.curva.dias[i]).toFixed(1)} ${cy(v).toFixed(1)}`).join(' ');
const pTodos = linha(dados.curva.todos);
const pFechados = linha(dados.curva.so_fechados);
const fimTodos = dados.curva.todos[dados.curva.todos.length - 1];

// ---------- simulador ----------
const S = { x0: 40, x1: 392, y0: 12, y1: 132, amax: 140 };
const sx = (a: number) => S.x0 + (a / S.amax) * (S.x1 - S.x0);
const sy = (p: number) => S.y1 - p * (S.y1 - S.y0);
const sim = dados.sim as Record<string, number[][]>;
const curvasSim = (['1', '2', '3'] as const).map((q) => ({
	q,
	d: sim[q].map((r, i) => `${i ? 'L' : 'M'}${sx(r[0]).toFixed(1)} ${sy(r[2]).toFixed(1)}`).join(' '),
}));
const INI = { idade: 45, mes: '3' };
const r0 = sim[INI.mes].find((r) => r[0] === INI.idade)!;

// ---------- teste retroativo (4º trimestre de 2017, pipeline aberto em 30/09) ----------
const teste = [
	{ k: 'real', v: 1216962, cls: 'b-real' },
	{ k: 'm0', v: 3647327, cls: 'b-mod' },
	{ k: 'm1', v: 2042462, cls: 'b-mod' },
	{ k: 'm2', v: 1758712, cls: 'b-mod' },
	{ k: 'm3', v: 1538243, cls: 'b-best' },
] as const;
// largura em % do trilho; a folga à direita guarda espaço para o valor da maior barra
const vmax = 4700000;
const bw = (v: number) => +((v / vmax) * 100).toFixed(2);

// ---------- alarme: entradas semanais por regional ----------
const sem = dados.central;
const A = { x0: 48, x1: 628, y0: 16, y1: 196, ymax: 240 };
const ax = (i: number) => A.x0 + (i / (sem.length - 1)) * (A.x1 - A.x0);
const ay = (v: number) => A.y1 - (v / A.ymax) * (A.y1 - A.y0);
const serie = (k: 'central' | 'east' | 'west') =>
	sem.map((w, i) => `${i ? 'L' : 'M'}${ax(i).toFixed(1)} ${ay(w[k]).toFixed(1)}`).join(' ');
const marcadas = ['2017-07-17', '2017-07-24', '2017-07-31'];
const iMarc = sem.map((w, i) => (marcadas.includes(w.semana) ? i : -1)).filter((i) => i >= 0);
const passo = (A.x1 - A.x0) / (sem.length - 1);
const mesLabel = (s: string) =>
	new Date(s + 'T12:00:00').toLocaleDateString(locale, { day: '2-digit', month: 'short' });
const ticksSem = sem.map((w, i) => ({ i, w })).filter((_, i) => i % 4 === 0);
---

<Layout title={t.meta.title} description={t.meta.description} path={SLUG}>
	<Header path={SLUG} />
	<main>
		<article>
			<header class="container top">
				<a class="back" href={`${home}#projetos`}>
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
					{t.voltar}
				</a>
				<div class="meta">
					<span class="num display">01</span>
					<span class="pill pill--brotando">{site.estagios.brotando}</span>
					<span class="muted">{t.andamento}</span>
				</div>
				<h1 class="display">{t.titulo}</h1>
				<div class="abertura">
					<p class="lead" set:html={t.lead} />
					<div class="ficha">
						<ul class="fatos">
							{t.fatos.map((f) => <li>{f}</li>)}
						</ul>
						<div class="acoes">
							<a class="btn btn--dark" href={REPO} target="_blank" rel="noopener">{t.codigo}</a>
							<a class="btn" href={COLAB} target="_blank" rel="noopener">{t.colab}</a>
						</div>
					</div>
				</div>
			</header>

			<section class="container bloco">
				<div class="resumo">
					<h2 class="display">{t.resumo.titulo}</h2>
					<ol>
						{t.resumo.itens.map((item) => <li set:html={item} />)}
					</ol>
				</div>
			</section>

			<section class="container bloco">
				<div class="cabeca">
					<h2 class="section-title">{t.hipoteses.titulo}</h2>
					<div class="prosa"><p>{t.hipoteses.intro}</p></div>
				</div>
				<div class="hip">
					{
						t.hipoteses.lista.map((h) => (
							<div class="hip-card">
								<span class={`veredito veredito--${h.tipo}`}>{h.veredito}</span>
								<p class="hip-q display">{h.hipotese}</p>
								<p class="hip-t">{h.texto}</p>
							</div>
						))
					}
				</div>
			</section>

			<section class="container bloco">
				<h2 class="section-title">{t.media.titulo}</h2>
				<div class="duo">
					<div class="prosa">{t.media.texto.map((p) => <p>{p}</p>)}</div>
					<figure class="fig">
						<svg viewBox="0 0 640 248" role="img" aria-label={t.media.aria}>
							{
								ticksY.map((v) => (
									<g>
										<line class="grid" x1={H.x0} x2={H.x1} y1={hy(v)} y2={hy(v)} />
										<text class="tick" x={H.x0 - 8} y={hy(v) + 4} text-anchor="end">{num.format(v)}</text>
									</g>
								))
							}
							{barras.map((b) => <rect class={b.rapido ? 'bar bar--rapido' : 'bar'} x={b.x} y={b.y} width={b.w} height={b.h} rx="2" />)}
							<line class="media" x1={hx(48)} x2={hx(48)} y1={H.y0} y2={H.y1} />
							<text class="media-t" x={hx(48) + 6} y={H.y0 + 12}>{t.media.mediaLabel}</text>
							{ticksX.map((v) => <text class="tick" x={hx(v)} y={H.y1 + 18} text-anchor="middle">{v}</text>)}
							<text class="eixo" x={(H.x0 + H.x1) / 2} y="240" text-anchor="middle">{t.media.eixo}</text>
						</svg>
					</figure>
				</div>
			</section>

			<section class="container bloco">
				<div class="cabeca">
					<h2 class="section-title">{t.destinos.titulo}</h2>
					<div class="prosa">{t.destinos.texto.map((p) => <p>{p}</p>)}</div>
				</div>
				<div class="cem" role="img" aria-label={fatias.map((f) => `${Math.round(f.v)}% ${f.label}`).join(', ')}>
					{
						fatias.map((f) => (
							<div class={`fatia ${f.cls}`} style={`flex-basis: ${f.v}%`}>
								<span class="fatia-n display">{Math.round(f.v)}</span>
								<span class="fatia-l">{f.label}</span>
							</div>
						))
					}
				</div>
				<div class="lado lado--fig">
					<figure class="fig">
						<figcaption class="fig-t">{t.destinos.curvaTitulo}</figcaption>
						<svg viewBox="0 0 640 254" role="img" aria-label={t.destinos.aria}>
							{
								[0, 25, 50, 75, 100].map((v) => (
									<g>
										<line class="grid" x1={C.x0} x2={C.x1} y1={cy(v)} y2={cy(v)} />
										<text class="tick" x={C.x0 - 8} y={cy(v) + 4} text-anchor="end">{v}%</text>
									</g>
								))
							}
							<line class="limite" x1={cx(138)} x2={cx(138)} y1={C.y0} y2={C.y1} />
							<text class="tick" x={cx(138) - 6} y={C.y1 - 8} text-anchor="end">138</text>
							<path class="l-fechados" d={pFechados} />
							<path class="l-todos" d={pTodos} />
							<text class="rot rot--ink" x={cx(96)} y={cy(97)} text-anchor="end">{t.destinos.serieFechados}</text>
							<text class="rot rot--mag" x={C.x1} y={cy(45)} text-anchor="end">{t.destinos.serieTodos} · {num.format(fimTodos)}%</text>
							{[0, 30, 60, 90, 120, 150].map((v) => <text class="tick" x={cx(v)} y={C.y1 + 18} text-anchor="middle">{v}</text>)}
							<text class="eixo" x={(C.x0 + C.x1) / 2} y="248" text-anchor="middle">{t.destinos.eixoX}</text>
						</svg>
					</figure>
					<p class="nota muted">{t.destinos.cuidado}</p>
				</div>
			</section>

			<section class="container bloco">
				<div class="sim" data-sim data-locale={locale}>
					<div class="sim-head">
						<h2 class="display">{t.sim.titulo}</h2>
						<p class="muted">{t.sim.intro}</p>
					</div>
					<div class="sim-body">
						<div class="sim-ctrl">
							<label class="ctrl-l" for={`idade-${lang}`}>
								{t.sim.dias} <strong data-idade>{INI.idade}</strong> {t.sim.diasUn}
							</label>
							<input id={`idade-${lang}`} type="range" min="0" max="140" step="5" value={INI.idade} />
							<div class="ctrl-l" id={`mes-${lang}`}>{t.sim.mes}</div>
							<div class="seg" role="group" aria-labelledby={`mes-${lang}`}>
								{
									t.sim.meses.map((m, i) => (
										<button type="button" data-mes={String(i + 1)} aria-pressed={String(i + 1) === INI.mes ? 'true' : 'false'}>
											{m}
										</button>
									))
								}
							</div>
							<dl class="leituras" aria-live="polite">
								<div class="leitura leitura--main">
									<dt>{t.sim.fecha30}</dt>
									<dd class="display" data-f30>{pctFmt.format(r0[2])}</dd>
								</div>
								<div class="leitura">
									<dt>{t.sim.ganha30}</dt>
									<dd class="display" data-w30>{pctFmt.format(r0[3])}</dd>
								</div>
								<div class="leitura">
									<dt>{t.sim.fechaAlgum}</dt>
									<dd class="display" data-ever>{pctFmt.format(r0[4])}</dd>
								</div>
							</dl>
						</div>
						<figure class="sim-fig">
							<figcaption class="fig-t">{t.sim.curva}</figcaption>
							<svg viewBox="0 0 400 156" role="img" aria-label={t.sim.aria}>
								{
									[0, 0.5, 1].map((v) => (
										<g>
											<line class="grid" x1={S.x0} x2={S.x1} y1={sy(v)} y2={sy(v)} />
											<text class="tick" x={S.x0 - 6} y={sy(v) + 4} text-anchor="end">{pctFmt.format(v)}</text>
										</g>
									))
								}
								{curvasSim.map((c) => <path class="sim-curva" d={c.d} data-curva={c.q} hidden={c.q !== INI.mes} />)}
								<circle class="dot" r="9" cx={sx(INI.idade)} cy={sy(r0[2])} data-dot />
								{[0, 35, 70, 105, 140].map((v) => <text class="tick" x={sx(v)} y={S.y1 + 18} text-anchor="middle">{v}</text>)}
							</svg>
							<p class="nota muted" data-base data-tpl={t.sim.base('{n}')} data-morto={t.sim.morto}>{t.sim.base(num.format(r0[1]))}</p>
						</figure>
					</div>
				</div>
				<script type="application/json" id="sim-dados" is:inline set:html={JSON.stringify({ sim, S })} />
			</section>

			<section class="container bloco">
				<div class="cabeca cabeca--larga">
					<h2 class="section-title">{t.receita.titulo}</h2>
					<div class="prosa">{t.receita.texto.map((p) => <p>{p}</p>)}</div>
				</div>
				<div class="lado lado--teste">
					<div>
						<h3 class="sub display">{t.receita.testeTitulo}</h3>
						<p class="prosa">{t.receita.testeTexto}</p>
						<ul class="notas">
							{t.receita.notas.map((n) => <li set:html={n} />)}
						</ul>
					</div>
					<figure class="fig">
						<div class="teste" role="img" aria-label={t.receita.aria} style={`--real: ${bw(teste[0].v)}%`}>
							{
								teste.map((b) => (
									<div class="t-row">
										<span class="b-label">{t.receita.barras[b.k]}</span>
										<span class="t-trilho">
											<span class={`t-bar ${b.cls}`} style={`width: ${bw(b.v)}%`} />
											<span class="b-val">{mi(b.v)}</span>
										</span>
									</div>
								))
							}
						</div>
					</figure>
				</div>
			</section>

			<section class="container bloco">
				<div class="cabeca">
					<h2 class="section-title">{t.alarme.titulo}</h2>
					<div class="prosa"><p>{t.alarme.texto[0]}</p></div>
				</div>
				<div class="lado lado--fig">
					<figure class="fig">
						<svg viewBox="0 0 640 254" role="img" aria-label={t.alarme.aria}>
							{iMarc.length > 0 && (
								<rect class="marca" x={ax(iMarc[0]) - passo / 2} y={A.y0} width={passo * iMarc.length} height={A.y1 - A.y0} rx="6" />
							)}
							{iMarc.length > 0 && <text class="marca-t" x={ax(iMarc[0]) - passo / 2 + 8} y={A.y1 - 10}>{t.alarme.destaque}</text>}
							{
								[0, 100, 200].map((v) => (
									<g>
										<line class="grid" x1={A.x0} x2={A.x1} y1={ay(v)} y2={ay(v)} />
										<text class="tick" x={A.x0 - 8} y={ay(v) + 4} text-anchor="end">{v}</text>
									</g>
								))
							}
							<path class="l-east" d={serie('east')} />
							<path class="l-west" d={serie('west')} />
							<path class="l-central" d={serie('central')} />
							<text class="rot rot--mag" x={ax(iMarc[iMarc.length - 1] ?? 8) + passo / 2 + 8} y={ay(170)}>{t.alarme.regionais.Central}</text>
							<text class="rot rot--ink" x={A.x1} y={ay(sem[sem.length - 1].east) - 36} text-anchor="end">{t.alarme.regionais.East}</text>
							<text class="rot rot--ora" x={A.x1} y={ay(sem[sem.length - 1].west) - 8} text-anchor="end">{t.alarme.regionais.West}</text>
							{ticksSem.map(({ i, w }) => <text class="tick" x={ax(i)} y={A.y1 + 18} text-anchor="middle">{mesLabel(w.semana)}</text>)}
							<text class="eixo" x={(A.x0 + A.x1) / 2} y="248" text-anchor="middle">{t.alarme.eixo}</text>
						</svg>
					</figure>
					<div class="prosa">{t.alarme.texto.slice(1).map((p) => <p>{p}</p>)}</div>
				</div>
			</section>

			<section class="container bloco">
				<div class="pares">
					<div>
						<h2 class="section-title">{t.falhou.titulo}</h2>
						<ul class="lista">{t.falhou.itens.map((i) => <li set:html={i} />)}</ul>
					</div>
					<div>
						<h2 class="section-title">{t.limites.titulo}</h2>
						<ul class="lista">{t.limites.itens.map((i) => <li>{i}</li>)}</ul>
						<p class="proximos">{t.limites.proximos}</p>
					</div>
				</div>
			</section>

			<section class="container bloco fim">
				<p class="display fim-t">{t.fim.codigo}</p>
				<div class="acoes">
					<a class="btn btn--dark" href={REPO} target="_blank" rel="noopener">{t.codigo}</a>
					<a class="btn" href={`${home}#projetos`}>{t.fim.voltar}</a>
				</div>
			</section>
		</article>
	</main>
	<Footer />
</Layout>

<script>
	type Dados = { sim: Record<string, number[][]>; S: { x0: number; x1: number; y0: number; y1: number; amax: number } };
	const el = document.getElementById('sim-dados');
	const box = document.querySelector<HTMLElement>('[data-sim]');
	if (el && box) {
		const { sim, S } = JSON.parse(el.textContent || '{}') as Dados;
		const pct = new Intl.NumberFormat(box.dataset.locale, { style: 'percent' });
		const num = new Intl.NumberFormat(box.dataset.locale);
		const input = box.querySelector<HTMLInputElement>('input[type=range]')!;
		const botoes = [...box.querySelectorAll<HTMLButtonElement>('[data-mes]')];
		const curvas = [...box.querySelectorAll<SVGPathElement>('[data-curva]')];
		const dot = box.querySelector<SVGCircleElement>('[data-dot]')!;
		const base = box.querySelector<HTMLElement>('[data-base]')!;
		const set = (sel: string, v: string) => (box.querySelector(sel)!.textContent = v);
		let mes = botoes.find((b) => b.getAttribute('aria-pressed') === 'true')?.dataset.mes ?? '3';

		const update = () => {
			const idade = Number(input.value);
			const r = sim[mes].find((x) => x[0] === idade) ?? sim[mes][sim[mes].length - 1];
			set('[data-idade]', String(idade));
			set('[data-f30]', pct.format(r[2]));
			set('[data-w30]', pct.format(r[3]));
			set('[data-ever]', pct.format(r[4]));
			dot.setAttribute('cx', String(S.x0 + (idade / S.amax) * (S.x1 - S.x0)));
			dot.setAttribute('cy', String(S.y1 - r[2] * (S.y1 - S.y0)));
			curvas.forEach((c) => c.toggleAttribute('hidden', c.dataset.curva !== mes));
			botoes.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mes === mes)));
			base.textContent =
				idade >= 140 ? base.dataset.morto! : base.dataset.tpl!.replace('{n}', num.format(r[1]));
		};

		input.addEventListener('input', update);
		botoes.forEach((b) =>
			b.addEventListener('click', () => {
				mes = b.dataset.mes!;
				update();
			}),
		);
		update();
	}
</script>

<style>
	.top {
		padding-top: 40px;
		padding-bottom: 72px;
	}
	.back {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		min-height: 44px;
		font-weight: 600;
		font-size: 16px;
		text-decoration: none;
	}
	.back svg {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
		margin-top: 28px;
		font-size: 15px;
	}
	.num {
		font-size: 20px;
		letter-spacing: 0;
	}
	h1 {
		margin: 18px 0 0;
		max-width: 14ch;
		font-size: clamp(52px, 9vw, 112px);
		line-height: 0.92;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}
	.lead {
		margin: 32px 0 0;
		max-width: 700px;
		font-size: 24px;
		line-height: 1.4;
		text-wrap: pretty;
	}
	.lead :global(em) {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 700;
	}
	.fatos {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin: 28px 0 0;
		padding: 0;
		list-style: none;
	}
	.fatos li {
		border: 2px solid var(--ink);
		border-radius: 999px;
		padding: 6px 14px;
